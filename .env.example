# SkillBridge Supabase Public Configuration (Accessible to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# SkillBridge Server-Side Privileged Credentials (DO NOT prefix with NEXT_PUBLIC_)
# NEVER expose these to the browser or bundle into client code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Platform Governance Bootstrap Secret
# High-entropy token used during initial provisioning or emergency recovery
ADMIN_BOOTSTRAP_SECRET=generate-a-secure-random-token-here

# Email Delivery Provider (Resend / SendGrid / Supabase SMTP)
RESEND_API_KEY=re_your_api_key_here
SYSTEM_EMAIL_FROM=support@skillbridge.edu

# NVIDIA AI Cloud Integration (Server-Side Only - NEVER expose to browser)
# Used for natural-language service matching and intent extraction on Explore and Home
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions

# Razorpay Payment Gateway Sandbox (Test Mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

